# Maintainer: marth <marthofdoom@gmail.com>
pkgname=new-lg4ff-dkms
pkgver=0.7.0
pkgrel=1
pkgdesc="Improved Logitech steering wheel force feedback driver (marthofdoom fork, DKMS)"
arch=('any')
url="https://github.com/marthofdoom/new-lg4ff"
license=('GPL-2.0-only')
depends=('dkms')
provides=('hid-logitech-new')
source=("$pkgname-$pkgver.tar.gz::https://github.com/marthofdoom/new-lg4ff/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "new-lg4ff-$pkgver"
    install -dm755 "$pkgdir/usr/src/new-lg4ff-$pkgver"
    install -m644 Makefile Kbuild dkms.conf *.c *.h "$pkgdir/usr/src/new-lg4ff-$pkgver/"
    sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$pkgver\"/" "$pkgdir/usr/src/new-lg4ff-$pkgver/dkms.conf"
}
